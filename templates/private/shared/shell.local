# Private shell aliases and functions (from private overlay)
# This file is sourced by .shell_common
#
# Add your private aliases here:
# alias myalias='my command'
#
# Add private functions:
# myfunction() {
#     echo "Hello from private function"
# }
#
# Profile-specific initialization (if you have per-profile setup scripts)
# PROFILE="$(cat ~/.dotfiles/.profile 2>/dev/null || echo 'unknown')"
# [ -f "$HOME/.dotfiles.private/$PROFILE/init.sh" ] && source "$HOME/.dotfiles.private/$PROFILE/init.sh"
