# ============================================================================
# Managed shell config (aggressive mode only)
# ============================================================================
# This file is part of the dotfiles repo and sourced by .shell_common.
# Put private customizations in ~/.shell.local (via private overlay).

# mise activation (language version manager)
if command -v mise &>/dev/null; then
    # Detect shell and activate appropriately
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(mise activate zsh)"
    elif [ -n "$BASH_VERSION" ]; then
        eval "$(mise activate bash)"
    fi
fi
