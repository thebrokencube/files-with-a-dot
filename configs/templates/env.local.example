# ~/.env.local - Sensitive environment variables
# This file is created by sync.sh and is ignored by git (not committed)
# Sourced by all shells (via .shell_common)

# Add your environment variables here
# Examples:
# GITHUB_TOKEN=ghp_...
# OPENAI_API_KEY=sk-...
# WORK_NPM_TOKEN=...
# INTERNAL_API_URL=https://...
