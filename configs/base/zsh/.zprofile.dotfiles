# ~/.zprofile.dotfiles - Dotfiles zsh login shell configuration
# This file is sourced by ~/.zprofile (added by sync.sh)

# Homebrew initialization (needed early for PATH)
if [ -f "/opt/homebrew/bin/brew" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -f "/usr/local/bin/brew" ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
