#!/usr/bin/env bash
set -euo pipefail

# folio-status — derive and display target state from file system
# Exit codes: 0 = success, 1 = error

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly BOLD='\033[1m'
readonly DIM='\033[2m'
readonly RESET='\033[0m'

FOLIO_PATH="./folio.yml"
JSON_MODE=false

usage() {
  cat <<EOF
Usage: folio-status [--folio PATH] [--json]

Derive and display target state for a folio project.

Options:
  --folio PATH   Path to folio.yml (default: ./folio.yml)
  --json         Machine-readable JSON output
  --help         Show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --folio) FOLIO_PATH="$2"; shift 2 ;;
    --json) JSON_MODE=true; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if [[ ! -f "$FOLIO_PATH" ]]; then
  echo -e "${RED}Error:${RESET} folio.yml not found at $FOLIO_PATH" >&2
  exit 1
fi

folio_dir=$(dirname "$FOLIO_PATH")
project=$(yq eval '.project' "$FOLIO_PATH")

# Get file mtime in seconds since epoch (portable macOS/Linux)
file_mtime() {
  local path="$1"
  if [[ "$(uname)" == "Darwin" ]]; then
    stat -f '%m' "$path" 2>/dev/null
  else
    stat -c '%Y' "$path" 2>/dev/null
  fi
}

# Derive status for a single local output against its sources
# Args: target_id, output_path, source_paths (newline-separated)
derive_local_status() {
  local output_path="$1"
  shift
  local -a source_paths=("$@")

  local full_output="$folio_dir/$output_path"

  if [[ ! -f "$full_output" ]]; then
    echo "missing"
    return
  fi

  local output_mtime
  output_mtime=$(file_mtime "$full_output")

  for src in "${source_paths[@]}"; do
    local full_src="$folio_dir/$src"
    if [[ ! -f "$full_src" ]]; then
      echo "stale"
      return
    fi
    local src_mtime
    src_mtime=$(file_mtime "$full_src")
    if [[ "$src_mtime" -gt "$output_mtime" ]]; then
      echo "stale"
      return
    fi
  done

  echo "clean"
}

# Compute days since a date string (YYYY-MM-DD)
days_since() {
  local date_str="$1"
  local now cached_epoch
  if [[ "$(uname)" == "Darwin" ]]; then
    cached_epoch=$(date -jf '%Y-%m-%d' "$date_str" '+%s' 2>/dev/null) || return 1
  else
    cached_epoch=$(date -d "$date_str" '+%s' 2>/dev/null) || return 1
  fi
  now=$(date '+%s')
  echo $(( (now - cached_epoch) / 86400 ))
}

# Classify a project-level source entry by index
# Sets: src_kind, src_label
classify_source() {
  local idx="$1"
  local s_path s_ext s_id s_derived

  s_path=$(yq eval ".sources[$idx].path" "$FOLIO_PATH")
  s_ext=$(yq eval ".sources[$idx].external" "$FOLIO_PATH")
  s_id=$(yq eval ".sources[$idx].id" "$FOLIO_PATH")
  s_derived=$(yq eval ".sources[$idx].derived_from" "$FOLIO_PATH")

  if [[ "$s_ext" != "null" && -n "$s_ext" ]]; then
    # External or code source
    if [[ "$s_ext" == "github" ]]; then
      src_kind="code"
    else
      src_kind="external"
    fi
    src_label="$s_ext"
    [[ "$s_id" != "null" && -n "$s_id" ]] && src_label+=" $s_id"
  elif [[ "$s_path" != "null" && -n "$s_path" ]]; then
    if [[ "$s_derived" != "null" ]]; then
      src_kind="derived"
      df_cached=$(yq eval ".sources[$idx].derived_from.cached" "$FOLIO_PATH")
      src_label="$s_path"
      if [[ "$df_cached" != "null" && -n "$df_cached" ]]; then
        local age
        age=$(days_since "$df_cached" 2>/dev/null) || age=""
        if [[ -n "$age" ]]; then
          src_label+=" (cached ${age}d ago)"
        fi
      fi
    else
      src_kind="primary"
      src_label="$s_path"
    fi
  else
    src_kind="unknown"
    src_label="(unrecognized entry)"
  fi
}

# Collect target data
target_ids=$(yq eval '.targets | keys | .[]' "$FOLIO_PATH" 2>/dev/null)

# Collect project-level sources
proj_src_count=$(yq eval '.sources | length' "$FOLIO_PATH" 2>/dev/null)
[[ "$proj_src_count" == "null" ]] && proj_src_count=0

# JSON output mode
if [[ "$JSON_MODE" == true ]]; then
  # Build project-level sources JSON
  json_proj_sources="["
  first_psrc=true
  if [[ "$proj_src_count" -gt 0 ]]; then
    for ((i = 0; i < proj_src_count; i++)); do
      [[ "$first_psrc" == true ]] && first_psrc=false || json_proj_sources+=","
      classify_source "$i"
      # Escape quotes
      escaped_label="${src_label//\"/\\\"}"
      json_proj_sources+="{\"kind\":\"$src_kind\",\"label\":\"$escaped_label\"}"
    done
  fi
  json_proj_sources+="]"

  json_targets="{"
  first_target=true

  if [[ -n "$target_ids" && "$target_ids" != "null" ]]; then
    while IFS= read -r target_id; do
      [[ -z "$target_id" ]] && continue
      [[ "$first_target" == true ]] && first_target=false || json_targets+=","

      # Collect sources
      source_paths=()
      src_count=$(yq eval ".targets.\"$target_id\".sources | length" "$FOLIO_PATH" 2>/dev/null)
      if [[ "$src_count" != "null" && "$src_count" -gt 0 ]]; then
        for ((i = 0; i < src_count; i++)); do
          sp=$(yq eval ".targets.\"$target_id\".sources[$i].path" "$FOLIO_PATH")
          [[ "$sp" != "null" ]] && source_paths+=("$sp")
        done
      fi

      # Check outputs
      json_outputs="["
      first_output=true
      out_count=$(yq eval ".targets.\"$target_id\".outputs | length" "$FOLIO_PATH" 2>/dev/null)
      if [[ "$out_count" != "null" && "$out_count" -gt 0 ]]; then
        for ((i = 0; i < out_count; i++)); do
          [[ "$first_output" == true ]] && first_output=false || json_outputs+=","

          out_path=$(yq eval ".targets.\"$target_id\".outputs[$i].path" "$FOLIO_PATH")
          ext=$(yq eval ".targets.\"$target_id\".outputs[$i].external" "$FOLIO_PATH")
          ext_id=$(yq eval ".targets.\"$target_id\".outputs[$i].id" "$FOLIO_PATH")

          if [[ "$ext" != "null" && -n "$ext" ]]; then
            status="unknown"
            json_outputs+="{\"type\":\"external\",\"system\":\"$ext\",\"id\":\"$ext_id\",\"status\":\"$status\"}"
          elif [[ "$out_path" != "null" && -n "$out_path" ]]; then
            status=$(derive_local_status "$out_path" "${source_paths[@]}")
            json_outputs+="{\"type\":\"local\",\"path\":\"$out_path\",\"status\":\"$status\"}"
          fi
        done
      fi
      json_outputs+="]"

      # Build sources JSON
      json_sources="["
      first_src=true
      for sp in "${source_paths[@]}"; do
        [[ "$first_src" == true ]] && first_src=false || json_sources+=","
        json_sources+="\"$sp\""
      done
      json_sources+="]"

      json_targets+="\"$target_id\":{\"sources\":$json_sources,\"outputs\":$json_outputs}"
    done <<< "$target_ids"
  fi
  json_targets+="}"

  # Tasks and pending counts
  task_count=$(yq eval '.tasks | length' "$FOLIO_PATH" 2>/dev/null)
  [[ "$task_count" == "null" ]] && task_count=0
  pending_count=$(yq eval '.pending | length' "$FOLIO_PATH" 2>/dev/null)
  [[ "$pending_count" == "null" ]] && pending_count=0

  echo "{\"project\":\"$project\",\"sources\":$json_proj_sources,\"targets\":$json_targets,\"tasks\":$task_count,\"pending\":$pending_count}"
  exit 0
fi

# Human-readable output
echo -e "${BOLD}$project${RESET}\n"

# Project-level sources
if [[ "$proj_src_count" -gt 0 ]]; then
  echo -e "Sources:"
  for ((i = 0; i < proj_src_count; i++)); do
    classify_source "$i"
    printf "  %-28s %s\n" "$src_label" "$src_kind"
  done
  echo ""
fi

if [[ -z "$target_ids" || "$target_ids" == "null" ]]; then
  echo -e "${DIM}No targets defined.${RESET}"
else
  echo -e "Targets:"
  while IFS= read -r target_id; do
    [[ -z "$target_id" ]] && continue

    # Collect sources
    source_paths=()
    src_count=$(yq eval ".targets.\"$target_id\".sources | length" "$FOLIO_PATH" 2>/dev/null)
    if [[ "$src_count" != "null" && "$src_count" -gt 0 ]]; then
      for ((i = 0; i < src_count; i++)); do
        sp=$(yq eval ".targets.\"$target_id\".sources[$i].path" "$FOLIO_PATH")
        [[ "$sp" != "null" ]] && source_paths+=("$sp")
      done
    fi

    # Check outputs
    out_count=$(yq eval ".targets.\"$target_id\".outputs | length" "$FOLIO_PATH" 2>/dev/null)
    if [[ "$out_count" != "null" && "$out_count" -gt 0 ]]; then
      for ((i = 0; i < out_count; i++)); do
        ext=$(yq eval ".targets.\"$target_id\".outputs[$i].external" "$FOLIO_PATH")
        ext_id=$(yq eval ".targets.\"$target_id\".outputs[$i].id" "$FOLIO_PATH")
        out_path=$(yq eval ".targets.\"$target_id\".outputs[$i].path" "$FOLIO_PATH")

        if [[ "$ext" != "null" && -n "$ext" ]]; then
          status="unknown"
          color="$YELLOW"
          detail="external: $ext $ext_id"
        elif [[ "$out_path" != "null" && -n "$out_path" ]]; then
          status=$(derive_local_status "$out_path" "${source_paths[@]}")
          case "$status" in
            clean)   color="$GREEN" ;;
            stale)   color="$YELLOW" ;;
            missing) color="$RED" ;;
            *)       color="$RESET" ;;
          esac
          detail="$out_path"
        else
          status="unknown"
          color="$YELLOW"
          detail="no output defined"
        fi

        printf "  %-24s ${color}%s${RESET} (%s)\n" "$target_id" "$status" "$detail"
      done
    fi

    # Show sources
    if [[ ${#source_paths[@]} -gt 0 ]]; then
      src_list=$(printf ", %s" "${source_paths[@]}")
      echo -e "  ${DIM}                        sources: ${src_list:2}${RESET}"
    fi
  done <<< "$target_ids"
fi

# Tasks and pending
task_count=$(yq eval '.tasks | length' "$FOLIO_PATH" 2>/dev/null)
[[ "$task_count" == "null" ]] && task_count=0
pending_count=$(yq eval '.pending | length' "$FOLIO_PATH" 2>/dev/null)
[[ "$pending_count" == "null" ]] && pending_count=0

echo ""
echo -e "Tasks: ${BOLD}$task_count${RESET} open"
echo -e "Pending: ${BOLD}$pending_count${RESET} notes"
