{
  "permissions": {
    "additionalDirectories": [
      "~/.dotfiles/",
      "~/.dotfiles.private/",
      "~/.folio/",
      "~/workspace/"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(ls*)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(pwd*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(git stash list*)",
      "Bash(git tag*)",
      "Bash(git config --get*)",
      "Bash(git ls-files*)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(tree *)",
      "Bash(test *)",
      "Bash(dot)",
      "Bash(dot *)",
      "Bash(folio)",
      "Bash(folio *)",
      "Bash(md-to-adf *)",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "printf '\\a' > /dev/tty" }
        ]
      }
    ]
  }
}
