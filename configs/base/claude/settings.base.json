{
  "effortLevel": "low",
  "skipAutoPermissionPrompt": true,
  "model": "opus",
  "outputStyle": "Concise",
  "theme": "dark-ansi",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/starship-claude"
  },
  "permissions": {
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.dotfiles/",
      "~/.dotfiles.private/",
      "~/.folio/",
      "~/workspace/",
      "/tmp/"
    ],
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",

      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(git stash list*)",
      "Bash(git tag*)",
      "Bash(git config --get*)",
      "Bash(git ls-files*)",
      "Bash(git add *)",
      "Bash(git checkout *)",
      "Bash(git fetch*)",
      "Bash(git rebase *)",
      "Bash(GIT_SEQUENCE_EDITOR*)",

      "Bash(ls*)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(pwd*)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(tree *)",
      "Bash(test *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(jq *)",

      "Bash(mkdir*)",
      "Bash(chmod *)",
      "Bash(cp *)",
      "Bash(mv *)",

      "Bash(ruby *)",
      "Bash(bundle*)",
      "Bash(bin/*)",

      "Bash(mise ls *)",
      "Bash(mise ls-remote *)",

      "Bash(cd *)",
      "Bash(gh *)",
      "Bash(acli *)",

      "Bash(dot*)",
      "Bash(direnv exec *)",
      "Bash(folio*)",
      "Bash(FOLIO_HOME=/tmp/folio-ws-* folio *)",
      "Bash(brew *)",
      "Bash(sleep *)",
      "Bash(sed *)",
      "Bash(date *)",
      "Bash(touch *)",
      "Bash(printf *)",
      "Bash(xargs *)",
      "Bash(awk *)",
      "WebFetch",

      "ListMcpResourcesTool",
      "ReadMcpResourceTool"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git push *)",
      "Bash(jj git push *)"
    ]
  },
  "memory": {
    "enabled": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "~/.dotfiles/configs/base/claude/.claude/hooks/block-permission-bypass.sh" }
        ]
      },
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          { "type": "command", "command": "~/.dotfiles/configs/base/claude/.claude/hooks/pre-commit-review.sh" }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "printf '\\a' > /dev/tty" }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "~/.dotfiles/configs/base/claude/.claude/hooks/post-compact.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "~/.dotfiles/configs/base/claude/.claude/hooks/folio-session-start.sh" }
        ]
      }
    ]
  }
}
