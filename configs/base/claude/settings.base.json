{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.68",
        "--headless",
        "--viewport-size=1280x720",
        "--allow-unrestricted-file-access"
      ]
    }
  },
  "permissions": {
    "additionalDirectories": [
      "~/.dotfiles/",
      "~/.dotfiles.private/",
      "~/.folio/",
      "~/workspace/",
      "/tmp/"
    ],
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",

      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(git stash list*)",
      "Bash(git tag*)",
      "Bash(git config --get*)",
      "Bash(git ls-files*)",
      "Bash(git add *)",
      "Bash(git checkout *)",
      "Bash(git fetch*)",
      "Bash(git rebase *)",
      "Bash(GIT_SEQUENCE_EDITOR*)",

      "Bash(ls*)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(pwd*)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(tree *)",
      "Bash(test *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(jq *)",

      "Bash(rm *)",
      "Bash(mkdir*)",
      "Bash(chmod *)",
      "Bash(cp *)",
      "Bash(mv *)",

      "Bash(ruby *)",
      "Bash(bundle*)",
      "Bash(bin/*)",

      "Bash(git *)",
      "Bash(cd * && git *)",
      "Bash(gh *)",
      "Bash(acli *)",

      "Bash(dot*)",
      "Bash(folio*)",
      "Bash(FOLIO_HOME=/tmp/folio-ws-* folio *)",
      "Bash(brew *)",
      "Bash(sleep *)",
      "Bash(sed *)",
      "Bash(bash *)",
      "Bash(zsh *)",
      "Bash(date *)",
      "Bash(touch *)",
      "Bash(printf *)",
      "Bash(xargs *)",
      "Bash(awk *)",
      "WebFetch",

      "ListMcpResourcesTool",
      "ReadMcpResourceTool",

      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_snapshot"
    ]
  },
  "enabledPlugins": {
    "playground@claude-plugins-official": true
  },
  "memory": {
    "enabled": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "~/.dotfiles/configs/base/claude/.claude/hooks/no-command-chaining.sh" }
        ]
      },
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          { "type": "command", "command": "~/.dotfiles/configs/base/claude/.claude/hooks/pre-commit-review.sh" }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "printf '\\a' > /dev/tty" }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "~/.dotfiles/configs/base/claude/.claude/hooks/post-compact.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "~/.dotfiles/configs/base/claude/.claude/hooks/folio-session-start.sh" }
        ]
      }
    ]
  }
}
