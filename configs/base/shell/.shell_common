# ~/.shell_common - Shared shell configuration
# Sourced by bash and zsh
# Keep this POSIX-compatible for compatibility

# ============================================================================
# PATH Configuration
# ============================================================================

# Homebrew (Apple Silicon)
[ -d "/opt/homebrew/bin" ] && export PATH="/opt/homebrew/bin:$PATH"

# Homebrew (Intel)
[ -d "/usr/local/bin" ] && export PATH="/usr/local/bin:$PATH"
[ -d "/usr/local/sbin" ] && export PATH="/usr/local/sbin:$PATH"

# Homebrew keg-only packages (curl, etc.)
[ -d "/opt/homebrew/opt/curl/bin" ] && export PATH="/opt/homebrew/opt/curl/bin:$PATH"

# User local binaries
[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"

# Obsidian CLI (bundled with Obsidian.app 1.12+)
[ -d "/Applications/Obsidian.app/Contents/MacOS" ] && export PATH="$PATH:/Applications/Obsidian.app/Contents/MacOS"

# ============================================================================
# Environment Variables
# ============================================================================

export EDITOR="nvim"
export VISUAL="nvim"
export LANG="en_US.UTF-8"

# XDG Base Directory (for apps that support it)
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"

# Folio home (knowledge work projects)
export FOLIO_HOME="$HOME/.folio"

# ============================================================================
# Aliases
# ============================================================================

# File listing
alias ll='ls -lG'
alias la='ls -laG'

# Editors
alias vim='nvim'
alias v='nvim'

# Git shortcuts (complement gitconfig aliases)
alias g='git'
alias gs='git status -sb'
alias gd='git diff'
alias gds='git diff --staged'
alias gl='git log --oneline -20'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gpl='git pull'

# Directory navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Safety
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Misc
alias reload='exec $SHELL -l'
alias path='echo $PATH | tr ":" "\n"'
alias week='date +%V'

# ============================================================================
# Load local/sensitive configuration
# ============================================================================

# Determine dotfiles location
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"

# Local environment variables (API keys, tokens - via private overlay)
[ -f "$HOME/.env.local" ] && . "$HOME/.env.local"

# Managed shell config (aggressive mode only - repo-controlled)
if [ -f "$DOTFILES_DIR/.machine" ] && [ "$(cat "$DOTFILES_DIR/.machine")" = "aggressive" ]; then
    [ -f "$DOTFILES_DIR/configs/aggressive/shell.managed" ] && . "$DOTFILES_DIR/configs/aggressive/shell.managed"
fi

# Private shell config (via private overlay)
[ -f "$HOME/.shell.local" ] && . "$HOME/.shell.local"

# ============================================================================
# Final PATH fixups
# ============================================================================

# Ensure mise shims take priority over Homebrew
[ -d "$HOME/.local/share/mise/shims" ] && export PATH="$HOME/.local/share/mise/shims:$PATH"
