# Ghostty terminal configuration
# See: https://ghostty.org/docs/config

# Font
font-family = Inconsolata Nerd Font
font-size = 14

# Theme
theme = tokyonight

# Cursor
cursor-style = block
cursor-style-blink = false

# Window
window-padding-x = 10
window-padding-y = 10
window-decoration = true

# Shell
shell-integration = detect

# Scrollback
scrollback-limit = 10000

# Selection
copy-on-select = clipboard
clipboard-paste-protection = true

# Mouse
mouse-hide-while-typing = true

# Bell — show visual indicator on tab, no audible beep
bell-features = title,bounce,badge

# macOS specific
macos-option-as-alt = true
macos-titlebar-style = tabs

# Keybindings (use defaults mostly)
# Split panes
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+w=close_surface

# Navigate splits
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:top
keybind = super+alt+down=goto_split:bottom

# Tabs
keybind = super+t=new_tab
keybind = super+shift+left=previous_tab
keybind = super+shift+right=next_tab
