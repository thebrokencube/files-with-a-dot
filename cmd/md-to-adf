#!/usr/bin/env ruby
# frozen_string_literal: true

# Ad-hoc markdown→ADF converter for simple ticket descriptions.
# Handles: ## headings, **bold**, `code`, [links](url), - bullets, 1. ordered lists, paragraphs.
#
# Modes:
#   md-to-adf input.md                    → raw ADF doc JSON
#   md-to-adf --acli RETIRE-3100 input.md → acli --from-json payload
#   md-to-adf --acli RETIRE-3100 < input  → same, from stdin
#   md-to-adf --lint file.md              → validate markdown uses supported subset only

require "json"
require "strscan"
require "timeout"

TIMEOUT_SECONDS = 30
trap("PIPE", "SYSTEM_DEFAULT")

def parse_inline(text)
  return [] if text.nil? || text.strip.empty?

  segments = []
  ss = StringScanner.new(text)

  until ss.eos?
    if ss.scan(/\*\*(.+?)\*\*/)
      segments << { "type" => "text", "text" => ss[1], "marks" => [{ "type" => "strong" }] }
    elsif ss.scan(/`(.+?)`/)
      segments << { "type" => "text", "text" => ss[1], "marks" => [{ "type" => "code" }] }
    elsif ss.scan(%r{\[(.+?)\]\((https?://[^\)]+)\)})
      segments << { "type" => "text", "text" => ss[1], "marks" => [{ "type" => "link", "attrs" => { "href" => ss[2] } }] }
    elsif ss.scan(/.+?(?=\*\*|`|\[)/)
      segments << { "type" => "text", "text" => ss.matched }
    else
      segments << { "type" => "text", "text" => ss.rest }
      ss.terminate
    end
  end

  segments
end

def parse_markdown(input)
  lines = input.lines.map(&:chomp)
  content = []
  i = 0

  while i < lines.length
    line = lines[i]

    case line
    when /\A## (.+)/
      content << {
        "type" => "heading",
        "attrs" => { "level" => 2 },
        "content" => parse_inline($1)
      }
      i += 1
    when /\A- (.+)/
      items = []
      while i < lines.length && lines[i] =~ /\A- (.+)/
        items << {
          "type" => "listItem",
          "content" => [{ "type" => "paragraph", "content" => parse_inline($1) }]
        }
        i += 1
      end
      content << { "type" => "bulletList", "content" => items }
    when /\A\d+\. (.+)/
      items = []
      while i < lines.length && lines[i] =~ /\A\d+\. (.+)/
        items << {
          "type" => "listItem",
          "content" => [{ "type" => "paragraph", "content" => parse_inline($1) }]
        }
        i += 1
      end
      content << { "type" => "orderedList", "content" => items }
    when /\A\s*\z/
      i += 1
    else
      content << { "type" => "paragraph", "content" => parse_inline(line) }
      i += 1
    end
  end

  { "version" => 1, "type" => "doc", "content" => content }
end

def lint(input, filename)
  issues = []
  lines = input.lines
  in_code_block = false

  lines.each_with_index do |line, idx|
    lineno = idx + 1
    stripped = line.chomp

    # Track code block state (report the opening line, skip contents)
    if stripped =~ /\A```/
      if !in_code_block
        issues << [lineno, "code block (fenced) not supported"]
        in_code_block = true
      else
        in_code_block = false
      end
      next
    end
    next if in_code_block

    if stripped =~ /\A# [^#]/
      issues << [lineno, "h1 heading not supported (only ## supported)"]
    elsif stripped =~ /\A###+ /
      issues << [lineno, "level 3+ heading not supported (only ## supported)"]
    elsif stripped =~ /\A\|.+\|/
      issues << [lineno, "table syntax not supported"]
    elsif stripped =~ /\A>/
      issues << [lineno, "blockquote not supported"]
    elsif stripped =~ /\A  +- / || stripped =~ /\A\t+- /
      issues << [lineno, "nested list not supported"]
    elsif stripped =~ /\A  +\d+\. / || stripped =~ /\A\t+\d+\. /
      issues << [lineno, "nested list not supported"]
    elsif stripped =~ /- \[[ x]\]/
      issues << [lineno, "checkbox not supported"]
    end

    # Check inline: images, relative links, and bare [ not part of a valid [text](https://...) link
    # Strip code spans first so `![img](url)` inside backticks doesn't trigger false positives
    inline = stripped.gsub(/`.+?`/, "")
    if inline =~ /!\[/
      issues << [lineno, "image syntax not supported (![alt](url) produces a plain link, not an image)"]
    end
    inline = inline.gsub(%r{\[.+?\]\(https?://[^\)]+\)}, "")
    if inline =~ /\[/
      issues << [lineno, "bare [ or relative link not supported (only [text](https://...) links)"]
    end
  end

  issues
end

# --- CLI ---

args = ARGV.dup

if args[0] == "--lint"
  args.shift
  all_issues = []

  if args.empty?
    if $stdin.tty?
      $stderr.puts "md-to-adf: --lint: no input file and stdin is a terminal"
      exit 1
    end
    input = $stdin.read
    lint(input, "<stdin>").each do |lineno, msg|
      all_issues << "<stdin>:#{lineno}: #{msg}"
    end
  else
    args.each do |file|
      input = File.read(file)
      lint(input, file).each do |lineno, msg|
        all_issues << "#{file}:#{lineno}: #{msg}"
      end
    end
  end

  unless all_issues.empty?
    all_issues.each { |issue| $stderr.puts issue }
    exit 1
  end
  exit 0
end

acli_key = nil
if args[0] == "--acli"
  args.shift
  acli_key = args.shift
end

if args[0]
  input = File.read(args[0])
elsif $stdin.tty?
  $stderr.puts "md-to-adf: no input file and stdin is a terminal (pipe a file or pass a filename)"
  exit 1
else
  input = $stdin.read
end

begin
  adf = Timeout.timeout(TIMEOUT_SECONDS) { parse_markdown(input) }
rescue Timeout::Error
  $stderr.puts "md-to-adf: timed out after #{TIMEOUT_SECONDS}s (possible parser bug)"
  exit 124
end

if acli_key
  puts JSON.pretty_generate({ "issues" => [acli_key], "description" => adf })
else
  puts JSON.pretty_generate(adf)
end
