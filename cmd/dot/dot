#!/usr/bin/env bash
# dot - dotfiles management CLI
# Usage: dot <command> [options]

set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
DOT_DIR="$DOTFILES_DIR/cmd/dot"

# Non-interactive auto-detection: if stdin isn't a TTY, set env var
if [[ ! -t 0 ]] && [[ -z "${DOTFILES_NONINTERACTIVE:-}" ]]; then
    export DOTFILES_NONINTERACTIVE=1
fi

# Colors
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
BLUE=$'\033[0;34m'
BOLD=$'\033[1m'
NC=$'\033[0m'

# Source config library
# shellcheck source=lib/config.sh
[[ -f "$DOT_DIR/lib/config.sh" ]] && source "$DOT_DIR/lib/config.sh"
# shellcheck source=lib/prompt.sh
[[ -f "$DOT_DIR/lib/prompt.sh" ]] && source "$DOT_DIR/lib/prompt.sh"

usage() {
    cat <<EOF
${BOLD}dot${NC} - dotfiles management

${BOLD}Usage:${NC}
  dot <command> [options]

${BOLD}Commands:${NC}
  sync      Apply local dotfiles to this machine + cleanup (no origin fetch)
  pull      Fetch from origin first, then sync + cleanup
  links     Symlinks only (no brew, no pull)
  health    Run health diagnostics
  fix       Health check with auto-fix
  clean     System cleanup only (--dry-run, --force)
  private   Manage private overlay (init, status, sync, push, edit)
  status    Show current dotfiles state
  validate  Run validation checks (shellcheck, syntax, symlinks, skills)
  edit      Open dotfiles in editor
  path      Print dotfiles directory (use: cd \$(dot path))
  help      Show this help

${BOLD}Options:${NC}
  --dry-run    Preview changes without applying
  --force      Auto-confirm all prompts
  --skip-brew  Skip Homebrew operations
  (all sync.sh and cleanup.sh options are passed through)

${BOLD}Examples:${NC}
  dot sync                 # Sync dotfiles + cleanup
  dot sync --dry-run       # Preview changes
  dot sync --force         # Non-interactive sync + cleanup
  dot pull                 # Pull latest, sync, cleanup
  dot health               # Check everything is healthy
  dot fix                  # Auto-fix broken symlinks
  dot clean                # Run cleanup independently
  dot clean --dry-run      # Show cleanup opportunities
  dot clean --force        # Execute cleanup without prompts
  dot private              # Show private overlay status
  dot private init         # Create private overlay from template
  dot private push "msg"   # Commit and push private changes
EOF
}

cmd_status() {
    echo -e "${BOLD}Dotfiles Status${NC}"
    echo ""

    # Machine type
    local machine_type
    machine_type="$(read_machine_type)"
    if [ -n "$machine_type" ]; then
        echo -e "  Mode:    ${GREEN}${machine_type}${NC}"
    else
        echo -e "  Mode:    ${YELLOW}not set${NC} (run dot sync)"
    fi

    # Private overlay
    if [ -d "$HOME/.dotfiles.private" ]; then
        echo -e "  Private: ${GREEN}yes${NC}"
    else
        echo -e "  Private: ${BLUE}no${NC}"
    fi

    # Git status
    echo ""
    echo -e "${BOLD}Repository${NC}"
    echo -e "  Path:    $DOTFILES_DIR"
    if command -v git &>/dev/null && [ -d "$DOTFILES_DIR/.git" ]; then
        local branch head
        branch="$(git -C "$DOTFILES_DIR" branch --show-current 2>/dev/null || echo "unknown")"
        head="$(git -C "$DOTFILES_DIR" log --oneline -1 2>/dev/null || echo "unknown")"
        echo -e "  Branch:  $branch"
        echo -e "  HEAD:    $head"

        # Check if clean
        if git -C "$DOTFILES_DIR" diff --quiet 2>/dev/null; then
            echo -e "  State:   ${GREEN}clean${NC}"
        else
            echo -e "  State:   ${YELLOW}uncommitted changes${NC}"
        fi
    fi

    # Symlinks
    local symlink_map="$DOTFILES_DIR/symlink_map.txt"
    if [ -f "$symlink_map" ]; then
        echo ""
        echo -e "${BOLD}Symlinks${NC}"
        while IFS= read -r line; do
            [ -z "$line" ] && continue
            echo "$line" | grep -q '^\s*#' && continue
            local name dest
            name="$(basename "$(echo "$line" | cut -d: -f1)")"
            dest="$(echo "$line" | cut -d: -f2-)"
            echo "  $name → $dest"
        done < "$symlink_map"
    fi
}

# Require dotfiles directory
if [ ! -d "$DOTFILES_DIR" ]; then
    echo -e "${RED}Error:${NC} Dotfiles not found at $DOTFILES_DIR"
    echo "Run bootstrap first: https://github.com/thebrokencube/files-with-a-dot"
    exit 1
fi

# Parse command
COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
    sync)
        "$DOT_DIR/sync.sh" "$@"
        # Offer cleanup after sync
        cleanup_args=()
        for arg in "$@"; do
            case "$arg" in
                --dry-run|--force) cleanup_args+=("$arg") ;;
            esac
        done
        if confirm "Run cleanup?" "no"; then
            "$DOT_DIR/cleanup.sh" --force "${cleanup_args[@]+"${cleanup_args[@]}"}"
        fi
        echo ""
        echo -e "${GREEN}Run 'reload' to apply shell changes.${NC}"
        ;;
    pull)
        "$DOT_DIR/sync.sh" --pull "$@"
        # Offer cleanup after sync
        cleanup_args=()
        for arg in "$@"; do
            case "$arg" in
                --dry-run|--force) cleanup_args+=("$arg") ;;
            esac
        done
        if confirm "Run cleanup?" "no"; then
            "$DOT_DIR/cleanup.sh" --force "${cleanup_args[@]+"${cleanup_args[@]}"}"
        fi
        echo ""
        echo -e "${GREEN}Run 'reload' to apply shell changes.${NC}"
        ;;
    links)
        "$DOT_DIR/sync.sh" --links-only "$@"
        ;;
    health)
        "$DOT_DIR/health.sh" "$@"
        ;;
    fix)
        "$DOT_DIR/health.sh" --fix "$@"
        ;;
    clean)
        "$DOT_DIR/cleanup.sh" "$@"
        ;;
    private)
        # Source libs needed for private overlay management
        # shellcheck source=lib/colors.sh
        source "$DOT_DIR/lib/colors.sh"
        # shellcheck source=lib/logging.sh
        source "$DOT_DIR/lib/logging.sh"
        # shellcheck source=lib/config.sh
        source "$DOT_DIR/lib/config.sh"
        # shellcheck source=lib/prompt.sh
        source "$DOT_DIR/lib/prompt.sh"
        # shellcheck source=lib/paths.sh
        source "$DOT_DIR/lib/paths.sh"
        # shellcheck source=lib/backup.sh
        source "$DOT_DIR/lib/backup.sh"
        # shellcheck source=lib/git.sh
        source "$DOT_DIR/lib/git.sh"
        # shellcheck source=lib/private.sh
        source "$DOT_DIR/lib/private.sh"

        init_backup

        subcmd="${1:-status}"
        shift 2>/dev/null || true
        case "$subcmd" in
            status)  private_status ;;
            init)    init_private_overlay "$@" ;;
            sync)    private_sync ;;
            pull)    private_pull ;;
            push)    private_push "$@" ;;
            edit)    "${EDITOR:-nvim}" "$HOME/.dotfiles.private" ;;
            path)    echo "$HOME/.dotfiles.private" ;;
            --help|-h)
                echo "Usage: dot private <action>"
                echo ""
                echo "Actions:"
                echo "  status   Show private overlay state (default)"
                echo "  init     Create private overlay from template"
                echo "  sync     Re-apply private symlinks"
                echo "  pull     Pull latest from remote"
                echo "  push     Commit and push changes (optional message arg)"
                echo "  edit     Open private overlay in editor"
                echo "  path     Print private overlay path (use: cd \$(dot private path))"
                ;;
            *)
                echo -e "${RED}Unknown private action:${NC} $subcmd"
                echo "Run 'dot private --help' for usage."
                exit 1
                ;;
        esac
        ;;
    validate)
        "$DOT_DIR/scripts/validate.sh" "$@"
        ;;
    status)
        cmd_status
        ;;
    edit)
        "${EDITOR:-nvim}" "$DOTFILES_DIR"
        ;;
    path)
        echo "$DOTFILES_DIR"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo -e "${RED}Unknown command:${NC} $COMMAND"
        echo ""
        usage
        exit 1
        ;;
esac
