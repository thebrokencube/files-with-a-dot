#!/usr/bin/env bash
# generate-building-blocks — harvest the building-block map from `//dendrik:` source tags (a pure
# projection). Deterministic: re-running with no source change is a no-op (a drift check enforces
# this via `git diff --exit-code`). Never hand-edit the outputs — authored fields live in the tags.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT_DIR="${ROOT}/plugins/dendrik/skills/dendrik/references"
GEN="DO NOT EDIT — generated by scripts/generate-building-blocks from //dendrik: source tags"
command -v jq >/dev/null || { echo "ERROR: jq is required" >&2; exit 1; }
cd "$ROOT"

# Harvest: scan every tracked .go file for `//dendrik:` tag blocks. A `//dendrik:block <id>`
# line opens an entry; subsequent `//dendrik:<key> <value>` lines attach to it; `source` is the
# file the block line was found in. Pure line-grep — no Go AST parsing (robust across substrates).
blocks_json() {
  # shellcheck disable=SC2016
  git ls-files '*.go' | xargs awk '
    function esc(s){ gsub(/\\/,"\\\\",s); gsub(/"/,"\\\"",s); return s }
    function flush(){ if(id=="") return;
      printf "{\"id\":\"%s\",\"kind\":\"%s\",\"layer\":\"%s\",\"status\":\"%s\",\"source\":\"%s\",\"definition\":\"%s\",\"intent\":\"%s\",\"conformance\":%s}\n",
        id,kind,layer,status,src,esc(def),esc(intent),conf;
      id="";kind="";layer="";status="";def="";intent="";conf="[]" }
    {
      p=index($0,"//dendrik:"); if(p==0) next
      rest=substr($0,p+10); key=rest; sub(/ .*/,"",key); val=rest; sub(/^[^ ]+ ?/,"",val)
      if(key=="block"){ flush(); id=val; src=FILENAME; conf="[]" }
      else if(key=="kind") kind=val
      else if(key=="layer") layer=val
      else if(key=="status") status=val
      else if(key=="definition") def=val
      else if(key=="intent") intent=val
      else if(key=="conformance"){ n=split(val,a," "); conf="["; for(i=1;i<=n;i++) conf=conf (i>1?",":"") "\"" a[i] "\""; conf=conf "]" }
    }
    END{ flush() }
  ' | jq -s 'sort_by(.id)'
}

BLOCKS="$(blocks_json)"
COUNT="$(jq 'length' <<<"$BLOCKS")"
mkdir -p "$OUT_DIR"

# JSON (machine surface)
jq -n --arg gen "$GEN" --argjson blocks "$BLOCKS" \
  '{_generated: $gen, count: ($blocks|length), blocks: $blocks}' \
  > "${OUT_DIR}/building-blocks.json"

# Markdown (human + agent surface)
{
  echo "<!-- ${GEN} -->"
  echo "# Dendrik building blocks"
  echo
  echo "The catalog of dendrik concepts a system can compose. Generated (pure projection); the"
  echo "authored fields live in \`//dendrik:\` tags at each concept's source. A blueprint's"
  echo "\`composes:\` ids resolve here. **${COUNT} blocks.**"
  echo
  jq -r '.[] |
    "### \(.id)\n"
    + "- kind: \(.kind)  ·  layer: \(.layer)  ·  status: \(.status)\n"
    + "- source: `\(.source)`\n"
    + (if (.conformance|length)>0 then "- conformance: " + (.conformance|join(", ")) + "\n" else "" end)
    + "- definition: \(.definition)\n"
    + "- intent: \(.intent)\n"' <<<"$BLOCKS"
} > "${OUT_DIR}/building-blocks.md"

echo "==> generated building-blocks.{json,md} — ${COUNT} blocks"
