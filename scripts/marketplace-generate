#!/usr/bin/env bash
# marketplace-generate — generate the proven Claude plugin catalog and bundle version mirrors.
# Deterministic: re-running with unchanged sources is a no-op. Generated outputs are never edited.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="${ROOT}/plugins.json"
DESCRIPTION="Claude Code plugins for the folio, jf, and dendrik command-line tools."
[[ -f "$SRC" ]] || { echo "ERROR: ${SRC} not found" >&2; exit 1; }
command -v jq >/dev/null || { echo "ERROR: jq is required" >&2; exit 1; }

# Each catalog entry points at a closed publishable bundle. The native Claude manifest owns the
# plugin version; cmd/<tool>/VERSION owns the binary version mirrored into that bundle.
entries() {
  jq -c '.plugins[]' "$SRC" | while IFS= read -r p; do
    local name path core manifest
    name="$(jq -r '.name' <<<"$p")"
    path="$(jq -r '.path' <<<"$p")"
    core="${ROOT}/cmd/${name}"
    manifest="${ROOT}/${path}/.claude-plugin/plugin.json"
    [[ "$path" == "plugins/${name}" ]] || { echo "ERROR: ${name}: path must be plugins/${name}" >&2; exit 1; }
    [[ -f "$manifest" ]] || { echo "ERROR: ${name}: missing ${path}/.claude-plugin/plugin.json" >&2; exit 1; }
    [[ -f "${ROOT}/${path}/skills/${name}/SKILL.md" ]] || { echo "ERROR: ${name}: missing bundle skill" >&2; exit 1; }
    [[ -x "${ROOT}/${path}/bin/setup" ]] || { echo "ERROR: ${name}: missing executable bin/setup" >&2; exit 1; }
    [[ -f "${core}/VERSION" ]] || { echo "ERROR: ${name}: missing cmd/${name}/VERSION" >&2; exit 1; }
    cp "${core}/VERSION" "${ROOT}/${path}/VERSION"
    ver="$(jq -r '.version' "$manifest")"
    jq --arg v "$ver" '{name, source: ("./" + .path), description, version: $v}' <<<"$p"
  done | jq -s '.'
}

write_catalog() {
  local dest="$1"
  mkdir -p "$(dirname "$dest")"
  jq -n \
    --arg description "$DESCRIPTION" \
    --argjson meta "$(jq '{name, owner}' "$SRC")" \
    --argjson plugins "$(entries)" \
    '{name: $meta.name, owner: $meta.owner, description: $description, plugins: $plugins}' \
    > "$dest"
}

write_catalog "${ROOT}/.claude-plugin/marketplace.json"

echo "==> generated Claude catalog and bundle version mirrors from plugins.json"
