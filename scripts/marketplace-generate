#!/usr/bin/env bash
# marketplace-generate — generate per-harness plugin catalogs from plugins.json (the one
# canonical, hand-edited manifest). Deterministic: re-running with no manifest change is a
# no-op (the smoke test enforces this via `git diff --exit-code`). Never hand-edit a catalog.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="${ROOT}/plugins.json"
GEN="DO NOT EDIT — generated by scripts/marketplace-generate from plugins.json"
[[ -f "$SRC" ]] || { echo "ERROR: ${SRC} not found" >&2; exit 1; }
command -v jq >/dev/null || { echo "ERROR: jq is required" >&2; exit 1; }

# Each plugin's catalog entry: name, relative source ("./<path>", resolved from repo root),
# description, and version. Shared across harnesses — the catalog shape is uniform; only the
# path differs. Version is synced from the plugin's own plugin.json (the source of truth per
# release.md) — never an independent value, since a stale catalog version blocks auto-updates.
entries() {
  jq -c '.plugins[]' "$SRC" | while IFS= read -r p; do
    local path ver
    path="$(jq -r '.path' <<<"$p")"
    ver="$(jq -r '.version' "${ROOT}/${path}/.claude-plugin/plugin.json")"
    jq --arg v "$ver" '{name, source: ("./" + .path), description, version: $v}' <<<"$p"
  done | jq -s '.'
}

write_catalog() {
  local dest="$1"
  mkdir -p "$(dirname "$dest")"
  jq -n \
    --arg gen "$GEN" \
    --argjson meta "$(jq '{name, owner}' "$SRC")" \
    --argjson plugins "$(entries)" \
    '{_generated: $gen, name: $meta.name, owner: $meta.owner, plugins: $plugins}' \
    > "$dest"
}

# Claude — guaranteed v1 deliverable, golden-path known format.
write_catalog "${ROOT}/.claude-plugin/marketplace.json"
# Cursor — best-effort; format mirrors the Claude catalog pending confirmation against
# Cursor's public plugin spec (an unconfirmed format does not block v1).
write_catalog "${ROOT}/.cursor-plugin/marketplace.json"
# Codex / agents — best-effort, same caveat as Cursor.
write_catalog "${ROOT}/.agents/plugins/marketplace.json"

echo "==> generated 3 catalogs from plugins.json"
