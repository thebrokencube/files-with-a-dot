#!/usr/bin/env bash
# check-blueprints — assert every per-system blueprint's `composes:` ids resolve to a real entry
# in dendrik's generated building-block map. A blueprint is only build-from-able if its concept
# references point at concepts that actually exist. Blueprints live in each tool's closed plugin
# bundle (`plugins/<tool>/skills/<tool>/references/blueprint.md`); dendrik owns the concept map.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MAP="${ROOT}/plugins/dendrik/skills/dendrik/references/building-blocks.json"
command -v jq >/dev/null || { echo "ERROR: jq is required" >&2; exit 1; }
[[ -f "$MAP" ]] || { echo "ERROR: ${MAP} not found (run scripts/generate-building-blocks)" >&2; exit 1; }
cd "$ROOT"

known="$(jq -r '.blocks[].id' "$MAP")"
rc=0
found_any=0
for bp in plugins/*/skills/*/references/blueprint.md; do
  [[ -f "$bp" ]] || continue
  found_any=1
  # the `composes:` line, ids comma-separated
  line="$(grep -m1 -E '^[[:space:]-]*composes:' "$bp" || true)"
  if [[ -z "$line" ]]; then
    echo "FAIL ${bp}: no 'composes:' line" >&2; rc=1; continue
  fi
  ids="${line#*composes:}"
  IFS=',' read -ra parts <<<"$ids"
  for id in "${parts[@]}"; do
    id="$(echo "$id" | tr -d '[:space:]')"
    [[ -z "$id" ]] && continue
    if ! grep -qx "$id" <<<"$known"; then
      echo "FAIL ${bp}: composes id '${id}' not in dendrik building-blocks.json" >&2; rc=1
    fi
  done
done
[[ "$found_any" == 1 ]] || { echo "ERROR: no plugins/*/skills/*/references/blueprint.md found" >&2; exit 1; }
[[ "$rc" == 0 ]] && echo "==> all blueprint composes: ids resolve in the map"
exit "$rc"
