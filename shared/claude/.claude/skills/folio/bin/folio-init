#!/usr/bin/env bash
set -euo pipefail

# folio-init — bootstrap a new folio.yml template
# Exit codes: 0 = created, 1 = error

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly BOLD='\033[1m'
readonly RESET='\033[0m'

PROJECT_NAME=""

usage() {
  cat <<EOF
Usage: folio-init [--name "Project Name"]

Create a minimal folio.yml in the current directory.

Options:
  --name NAME   Project name (interactive prompt if omitted)
  --help        Show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) PROJECT_NAME="$2"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if [[ -f "folio.yml" ]]; then
  echo -e "${RED}Error:${RESET} folio.yml already exists in $(pwd)" >&2
  exit 1
fi

# Interactive prompt if no name provided
if [[ -z "$PROJECT_NAME" ]]; then
  echo -e "${BOLD}Project name:${RESET} "
  read -r PROJECT_NAME
  if [[ -z "$PROJECT_NAME" ]]; then
    echo -e "${RED}Error:${RESET} project name is required" >&2
    exit 1
  fi
fi

cat > folio.yml <<EOF
schema: 1
project: "$PROJECT_NAME"

sources: []

targets: {}

tasks: []

pending: []
EOF

echo -e "${GREEN}✓${RESET} Created folio.yml for ${BOLD}${PROJECT_NAME}${RESET}"
