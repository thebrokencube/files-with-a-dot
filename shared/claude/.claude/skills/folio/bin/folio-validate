#!/usr/bin/env bash
set -euo pipefail

# folio-validate — structural validation of folio.yml
# Exit codes: 0 = valid, 1 = error, 2 = validation failure

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly BOLD='\033[1m'
readonly RESET='\033[0m'

FOLIO_PATH="./folio.yml"
JSON_MODE=false

usage() {
  cat <<EOF
Usage: folio-validate [--folio PATH] [--json]

Validate the structure of a folio.yml file.

Options:
  --folio PATH   Path to folio.yml (default: ./folio.yml)
  --json         Machine-readable JSON output
  --help         Show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --folio) FOLIO_PATH="$2"; shift 2 ;;
    --json) JSON_MODE=true; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

errors=()
warnings=()

add_error() { errors+=("$1"); }
# shellcheck disable=SC2329  # used in future validation rules
add_warning() { warnings+=("$1"); }

# Resolve folio directory for relative path checks
folio_dir=$(dirname "$FOLIO_PATH")

# --- Check: file exists ---
if [[ ! -f "$FOLIO_PATH" ]]; then
  if [[ "$JSON_MODE" == true ]]; then
    echo '{"valid":false,"errors":["folio.yml not found at '"$FOLIO_PATH"'"],"warnings":[]}'
  else
    echo -e "${RED}Error:${RESET} folio.yml not found at $FOLIO_PATH" >&2
  fi
  exit 2
fi

# --- Check: valid YAML ---
if ! yq eval '.' "$FOLIO_PATH" &>/dev/null; then
  if [[ "$JSON_MODE" == true ]]; then
    echo '{"valid":false,"errors":["folio.yml is not valid YAML"],"warnings":[]}'
  else
    echo -e "${RED}Error:${RESET} folio.yml is not valid YAML" >&2
  fi
  exit 2
fi

# --- Check: schema version ---
schema=$(yq eval '.schema' "$FOLIO_PATH")
if [[ "$schema" != "1" ]]; then
  add_error "Missing or invalid schema version (expected: 1, got: $schema)"
fi

# --- Check: project name ---
project=$(yq eval '.project' "$FOLIO_PATH")
if [[ "$project" == "null" || -z "$project" ]]; then
  add_error "Missing required field: project"
fi

# --- Check: deprecated context_sources ---
cs=$(yq eval '.context_sources' "$FOLIO_PATH")
if [[ "$cs" != "null" ]]; then
  add_warning "Deprecated key 'context_sources' found — migrate to 'sources'"
fi

# --- Check: project-level sources ---
proj_src_count=$(yq eval '.sources | length' "$FOLIO_PATH" 2>/dev/null)
if [[ "$proj_src_count" != "null" && "$proj_src_count" -gt 0 ]]; then
  for ((i = 0; i < proj_src_count; i++)); do
    src_path=$(yq eval ".sources[$i].path" "$FOLIO_PATH")
    src_ext=$(yq eval ".sources[$i].external" "$FOLIO_PATH")
    has_derived=$(yq eval ".sources[$i].derived_from" "$FOLIO_PATH")

    if [[ "$src_ext" != "null" && -n "$src_ext" ]]; then
      # External or code source — needs id
      src_id=$(yq eval ".sources[$i].id" "$FOLIO_PATH")
      if [[ "$src_id" == "null" || -z "$src_id" ]]; then
        add_error "Project source [$i]: external source '$src_ext' missing required field: id"
      fi
    elif [[ "$src_path" != "null" && -n "$src_path" ]]; then
      # Local source — check file exists
      if [[ ! -f "$folio_dir/$src_path" ]]; then
        add_error "Project source [$i]: file not found: $src_path"
      fi
      # If derived, check derived_from has external
      if [[ "$has_derived" != "null" ]]; then
        df_ext=$(yq eval ".sources[$i].derived_from.external" "$FOLIO_PATH")
        if [[ "$df_ext" == "null" || -z "$df_ext" ]]; then
          add_error "Project source [$i]: derived_from missing required field: external"
        fi
      fi
    fi
  done
fi

# --- Check: source file paths exist ---
# Iterate over all targets and their sources
target_ids=$(yq eval '.targets | keys | .[]' "$FOLIO_PATH" 2>/dev/null)
if [[ -n "$target_ids" && "$target_ids" != "null" ]]; then
  while IFS= read -r target_id; do
    [[ -z "$target_id" ]] && continue

    # Check sources (local paths and external entries)
    source_count=$(yq eval ".targets.\"$target_id\".sources | length" "$FOLIO_PATH" 2>/dev/null)
    if [[ "$source_count" != "null" && "$source_count" -gt 0 ]]; then
      for ((i = 0; i < source_count; i++)); do
        src_path=$(yq eval ".targets.\"$target_id\".sources[$i].path" "$FOLIO_PATH")
        src_ext=$(yq eval ".targets.\"$target_id\".sources[$i].external" "$FOLIO_PATH")
        if [[ "$src_ext" != "null" && -n "$src_ext" ]]; then
          # External source at target level — needs id
          src_id=$(yq eval ".targets.\"$target_id\".sources[$i].id" "$FOLIO_PATH")
          if [[ "$src_id" == "null" || -z "$src_id" ]]; then
            add_error "Target '$target_id': external source '$src_ext' missing required field: id"
          fi
        elif [[ "$src_path" != "null" && -n "$src_path" && ! -f "$folio_dir/$src_path" ]]; then
          add_error "Target '$target_id': source file not found: $src_path"
        fi
      done
    fi

    # Check local output paths (parent dir exists)
    output_count=$(yq eval ".targets.\"$target_id\".outputs | length" "$FOLIO_PATH" 2>/dev/null)
    if [[ "$output_count" != "null" && "$output_count" -gt 0 ]]; then
      for ((i = 0; i < output_count; i++)); do
        out_path=$(yq eval ".targets.\"$target_id\".outputs[$i].path" "$FOLIO_PATH")
        if [[ "$out_path" != "null" && "$out_path" != "" ]]; then
          out_dir=$(dirname "$folio_dir/$out_path")
          if [[ ! -d "$out_dir" ]]; then
            add_error "Target '$target_id': output parent directory not found: $(dirname "$out_path")"
          fi
        fi

        # Check external outputs have required fields
        ext=$(yq eval ".targets.\"$target_id\".outputs[$i].external" "$FOLIO_PATH")
        if [[ "$ext" != "null" && -n "$ext" ]]; then
          ext_id=$(yq eval ".targets.\"$target_id\".outputs[$i].id" "$FOLIO_PATH")
          if [[ "$ext_id" == "null" || -z "$ext_id" ]]; then
            add_error "Target '$target_id': external output '$ext' missing required field: id"
          fi
        fi
      done
    fi

    # Check blocked_by references exist
    blocked_count=$(yq eval ".targets.\"$target_id\".blocked_by | length" "$FOLIO_PATH" 2>/dev/null)
    if [[ "$blocked_count" != "null" && "$blocked_count" -gt 0 ]]; then
      for ((i = 0; i < blocked_count; i++)); do
        dep=$(yq eval ".targets.\"$target_id\".blocked_by[$i]" "$FOLIO_PATH")
        dep_exists=$(yq eval ".targets.\"$dep\"" "$FOLIO_PATH" 2>/dev/null)
        if [[ "$dep_exists" == "null" ]]; then
          add_error "Target '$target_id': blocked_by references non-existent target: $dep"
        fi
      done
    fi

    # Check batch items
    batch_count=$(yq eval ".targets.\"$target_id\".batch.items | length" "$FOLIO_PATH" 2>/dev/null)
    if [[ "$batch_count" != "null" && "$batch_count" -gt 0 ]]; then
      for ((i = 0; i < batch_count; i++)); do
        item_src=$(yq eval ".targets.\"$target_id\".batch.items[$i].source" "$FOLIO_PATH")
        if [[ "$item_src" != "null" && ! -f "$folio_dir/$item_src" ]]; then
          add_error "Target '$target_id': batch item source not found: $item_src"
        fi
      done
    fi

    # Check: transform field (required for every target)
    transform=$(yq eval ".targets.\"$target_id\".transform" "$FOLIO_PATH")
    if [[ "$transform" == "null" || -z "$transform" ]]; then
      add_error "Target '$target_id': missing required field: transform"
    else
      case "$transform" in
        distill|extract|adapt|compose|scaffold) ;;
        *) add_error "Target '$target_id': invalid transform '$transform' (must be: distill, extract, adapt, compose, scaffold)" ;;
      esac
    fi

    # Check: precompile rule — external outputs must have a local path sibling
    _has_external=false
    _has_local=false
    if [[ "$output_count" != "null" && "$output_count" -gt 0 ]]; then
      for ((i = 0; i < output_count; i++)); do
        _ext=$(yq eval ".targets.\"$target_id\".outputs[$i].external" "$FOLIO_PATH")
        _opath=$(yq eval ".targets.\"$target_id\".outputs[$i].path" "$FOLIO_PATH")
        [[ "$_ext" != "null" && -n "$_ext" ]] && _has_external=true
        [[ "$_opath" != "null" && -n "$_opath" ]] && _has_local=true
      done
    fi
    if [[ "$_has_external" == true && "$_has_local" == false ]]; then
      add_error "Target '$target_id': precompile rule — external outputs require a local path: sibling for review"
    fi
  done <<< "$target_ids"
fi

# --- Check: output map collisions ---
# Build output map: "key\ttarget_id" per line
_output_map=""
if [[ -n "$target_ids" && "$target_ids" != "null" ]]; then
  while IFS= read -r target_id; do
    [[ -z "$target_id" ]] && continue
    out_count=$(yq eval ".targets.\"$target_id\".outputs | length" "$FOLIO_PATH" 2>/dev/null)
    if [[ "$out_count" != "null" && "$out_count" -gt 0 ]]; then
      for ((i = 0; i < out_count; i++)); do
        out_path=$(yq eval ".targets.\"$target_id\".outputs[$i].path" "$FOLIO_PATH")
        ext=$(yq eval ".targets.\"$target_id\".outputs[$i].external" "$FOLIO_PATH")
        ext_id=$(yq eval ".targets.\"$target_id\".outputs[$i].id" "$FOLIO_PATH")
        if [[ "$out_path" != "null" && -n "$out_path" ]]; then
          _output_map="${_output_map}path:${out_path}	${target_id}
"
        fi
        if [[ "$ext" != "null" && -n "$ext" && "$ext_id" != "null" && -n "$ext_id" ]]; then
          _output_map="${_output_map}ext:${ext}:${ext_id}	${target_id}
"
        fi
      done
    fi
  done <<< "$target_ids"
fi

# Detect collisions (same output produced by multiple targets)
if [[ -n "$_output_map" ]]; then
  dupes=$(echo "$_output_map" | sed '/^$/d' | cut -f1 | sort | uniq -d)
  if [[ -n "$dupes" ]]; then
    while IFS= read -r dup_key; do
      [[ -z "$dup_key" ]] && continue
      producers=$(echo "$_output_map" | grep "^${dup_key}	" | cut -f2 | tr '\n' ', ' | sed 's/, $//')
      add_error "Output collision: '$dup_key' produced by multiple targets: $producers"
    done <<< "$dupes"
  fi
fi

# --- Edge inference ---
# Match target sources against the output map to infer dependency edges
_inferred_edges=""
if [[ -n "$target_ids" && "$target_ids" != "null" && -n "$_output_map" ]]; then
  while IFS= read -r target_id; do
    [[ -z "$target_id" ]] && continue
    src_count=$(yq eval ".targets.\"$target_id\".sources | length" "$FOLIO_PATH" 2>/dev/null)
    if [[ "$src_count" != "null" && "$src_count" -gt 0 ]]; then
      for ((i = 0; i < src_count; i++)); do
        src_path=$(yq eval ".targets.\"$target_id\".sources[$i].path" "$FOLIO_PATH")
        src_ext=$(yq eval ".targets.\"$target_id\".sources[$i].external" "$FOLIO_PATH")
        src_id=$(yq eval ".targets.\"$target_id\".sources[$i].id" "$FOLIO_PATH")
        lookup_key=""
        if [[ "$src_path" != "null" && -n "$src_path" ]]; then
          lookup_key="path:$src_path"
        elif [[ "$src_ext" != "null" && -n "$src_ext" && "$src_id" != "null" && -n "$src_id" ]]; then
          lookup_key="ext:$src_ext:$src_id"
        fi
        if [[ -n "$lookup_key" ]]; then
          producer=$(echo "$_output_map" | grep "^${lookup_key}	" | head -1 | cut -f2)
          if [[ -n "$producer" && "$producer" != "$target_id" ]]; then
            _inferred_edges="${_inferred_edges}${target_id}	${producer}
"
          fi
        fi
      done
    fi
  done <<< "$target_ids"
fi

# --- Check: dependency cycles (union of explicit blocked_by + inferred edges) ---
_all_edges="$_inferred_edges"
if [[ -n "$target_ids" && "$target_ids" != "null" ]]; then
  while IFS= read -r target_id; do
    [[ -z "$target_id" ]] && continue
    dep_count=$(yq eval ".targets.\"$target_id\".blocked_by | length" "$FOLIO_PATH" 2>/dev/null)
    if [[ "$dep_count" != "null" && "$dep_count" -gt 0 ]]; then
      for ((i = 0; i < dep_count; i++)); do
        dep=$(yq eval ".targets.\"$target_id\".blocked_by[$i]" "$FOLIO_PATH")
        _all_edges="${_all_edges}${target_id}	${dep}
"
      done
    fi
  done <<< "$target_ids"
fi

# DFS cycle detection over unified edge set (bash 3.2 compatible)
_visited=""
_in_stack=""

_is_in() { echo "$1" | grep -qFx "$2"; }
_add_to() { eval "$1=\"\${$1}
$2\""; }
_remove_from_stack() { _in_stack=$(echo "$_in_stack" | grep -vFx "$1"); }

_neighbors() {
  local node="$1"
  echo "$_all_edges" | awk -F'	' -v n="$node" '$1 == n { print $2 }'
}

dfs() {
  local node="$1"
  _add_to _visited "$node"
  _add_to _in_stack "$node"

  local neighbors
  neighbors=$(_neighbors "$node")
  if [[ -n "$neighbors" ]]; then
    while IFS= read -r dep; do
      [[ -z "$dep" ]] && continue
      if _is_in "$_in_stack" "$dep"; then
        add_error "Dependency cycle detected involving: $node -> $dep"
        _remove_from_stack "$node"
        return
      fi
      if ! _is_in "$_visited" "$dep"; then
        dfs "$dep"
      fi
    done <<< "$neighbors"
  fi

  _remove_from_stack "$node"
}

if [[ -n "$target_ids" && "$target_ids" != "null" ]]; then
  while IFS= read -r tid; do
    [[ -z "$tid" ]] && continue
    if ! _is_in "$_visited" "$tid"; then
      dfs "$tid"
    fi
  done <<< "$target_ids"
fi

# --- Output ---
error_count=${#errors[@]}
warning_count=${#warnings[@]}

if [[ "$JSON_MODE" == true ]]; then
  valid="true"
  [[ "$error_count" -gt 0 ]] && valid="false"

  # Build JSON arrays
  err_json="["
  for ((i = 0; i < error_count; i++)); do
    [[ $i -gt 0 ]] && err_json+=","
    # Escape quotes in error messages
    escaped="${errors[$i]//\"/\\\"}"
    err_json+="\"$escaped\""
  done
  err_json+="]"

  warn_json="["
  for ((i = 0; i < warning_count; i++)); do
    [[ $i -gt 0 ]] && warn_json+=","
    escaped="${warnings[$i]//\"/\\\"}"
    warn_json+="\"$escaped\""
  done
  warn_json+="]"

  echo "{\"valid\":$valid,\"errors\":$err_json,\"warnings\":$warn_json}"
else
  if [[ "$error_count" -gt 0 ]]; then
    echo -e "${RED}${BOLD}Validation failed${RESET} ($error_count error(s))\n"
    for err in "${errors[@]}"; do
      echo -e "  ${RED}✗${RESET} $err"
    done
  fi

  if [[ "$warning_count" -gt 0 ]]; then
    echo ""
    for warn in "${warnings[@]}"; do
      echo -e "  ${YELLOW}!${RESET} $warn"
    done
  fi

  if [[ "$error_count" -eq 0 ]]; then
    echo -e "${GREEN}${BOLD}Valid${RESET} — $FOLIO_PATH"
  fi
fi

[[ "$error_count" -gt 0 ]] && exit 2
exit 0
