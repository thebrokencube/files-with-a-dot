# Brewfile.shared - Core development tools for all machines

# Taps
tap "jesseduffield/lazygit"        # lazygit formula

# Core tools
brew "git"
brew "neovim"

# Language version management
brew "mise"                     # Universal version manager (replaces fnm, rbenv, etc.)

# Languages
brew "go"                       # Go compiler (folio CLI)

# Shell and prompt
brew "zsh"
brew "starship"                 # Cross-shell prompt

# Search and navigation
brew "ripgrep"                  # Fast grep (rg)
brew "fd"                       # Fast find
brew "fzf"                      # Fuzzy finder
brew "tree"                     # Directory tree viewer
brew "bat"                      # Better cat with syntax highlighting

# Git tools
brew "lazygit"                  # Terminal UI for git
brew "gh"                       # GitHub CLI

# JSON/data tools
brew "jq"                       # JSON processor

# Network
brew "wget"
brew "curl"

# Containers
brew "colima"                   # Lightweight Docker runtime
brew "docker"                   # Docker CLI

# Terminal
cask "ghostty"                  # Modern terminal emulator
cask "iterm2"                   # Fallback terminal

# Knowledge management
cask "obsidian"                 # Vault browser for ~/.folio

# Fonts
cask "font-inconsolata-nerd-font"
